rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 每本護照放在 trips/<一串很長的隨機代碼>/ 底下。
    // 只有知道代碼（也就是拿到連結）的人讀得到；沒有人能列出所有護照。
    match /trips/{tripId}/{coll}/{docId} {
      allow read: if request.auth != null && tripId.size() >= 20;
      allow write: if request.auth != null
                   && tripId.size() >= 20
                   && coll in ['quests', 'checkins', 'notes'];
    }
  }
}
